{
  "name": "@local/dsh-session-manager",
  "version": "1.2.0",
  "description": "Session management with confirmed permanent deletion for DSH",
  "private": true,
  "type": "module",
  "engines": { "dsh": "0.2.2-rc.1" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "manager.js", "runtime-lifecycle.js", "cache-artifacts.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "tests/*.mjs"],
  "scripts": { "test": "node --test tests/*.test.mjs" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-ui-sidebar", "@deepseek-ai/dsh-client-ui-workspace"]
    }
  }
}
